<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Replace the upstream OnePlus benz device tree -->
    <remove-project name="LineageOS/android_device_oneplus_benz" />
    <project
        path="device/oneplus/benz"
        name="i-m-sham/android_device_oneplus_benz"
        remote="github"
        revision="refs/heads/axion-benz" />

    <!-- Replace the upstream OnePlus SM8550 kernel -->
    <remove-project name="LineageOS/android_kernel_oneplus_sm8550" />
    <project
        path="kernel/oneplus/sm8550"
        name="i-m-sham/android_kernel_oneplus_sm8550"
        remote="github"
        revision="refs/heads/axion-benz" />

    <!-- Replace the upstream Axion common device configuration -->
    <remove-project name="android_device_axion_common" />
    <project
        path="device/axion/common"
        name="i-m-sham/android_device_axion_common"
        remote="github"
        revision="refs/heads/axion-benz" />
</manifest>
